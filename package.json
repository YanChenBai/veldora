{
  "name": "veldorajs",
  "version": "0.0.0",
  "description": "Next generation Electron build tooling based on Vite+",
  "keywords": [
    "cli",
    "electron",
    "plugin",
    "veldora",
    "vite",
    "vite-plus"
  ],
  "homepage": "https://github.com/YanChenBai/veldora",
  "bugs": {
    "url": "https://github.com/YanChenBai/veldora/issues"
  },
  "license": "MIT",
  "author": "byc <bycrxemail@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YanChenBai/veldora.git"
  },
  "bin": {
    "veldora": "bin/veldora.js",
    "vld": "bin/veldora.js"
  },
  "files": [
    "bin",
    "dist",
    "node.d.ts"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./node": {
      "types": "./node.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "format": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "test": "vp test run",
    "build": "vp check && vp pack",
    "release": "vp run check && vp run test && changelogen --release"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-arrow-functions": "^7.27.1",
    "cac": "^7.0.0",
    "magic-string": "^0.30.21",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.19.15",
    "changelogen": "^0.6.2",
    "typescript": "^5.9.3",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.12.4"
}
